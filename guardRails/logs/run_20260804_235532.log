name': 'flows.v1.co', 'line_number': 7, 'line_text': '$msg = "Blocked by the \'trend ai guard input\' flow: " + $result.reason', 'comment': None}}, {'_type': 'run_action', 'action_name': 'create_event', 'action_params': {'event': {'_type': 'TrendAiGuardRailException', 'message': '$msg'}}, '_source_mapping': {'filename': 'flows.v1.co', 'line_number': 8, 'line_text': 'create event TrendAiGuardRailException(message=$msg)', 'comment': None}}, {'_type': 'jump', '_next': 2}, {'_type': 'run_action', 'action_name': 'utter', 'action_params': {'value': 'refuse to respond'}, '_source_mapping': {'filename': 'flows.v1.co', 'line_number': 10, 'line_text': 'bot refuse to respond', 'comment': None}}, {'_type': 'run_action', 'action_name': 'utter', 'action_params': {'value': 'stop'}, '_source_mapping': {'filename': 'flows.v1.co', 'line_number': 11, 'line_text': 'stop', 'comment': None}}], 'source_code': '$result = execute trend_ai_guard(text=$user_message)\nif $result.blocked # Fails open if AI Guard service has an error\n    if $config.enable_rails_exceptions\n        $msg = "Blocked by the \'trend ai guard input\' flow: " + $result.reason\n        create event TrendAiGuardRailException(message=$msg)\n    else\n        bot refuse to respond\n    stop', 'is_system_flow': True, 'is_subflow': True}, {'id': 'trend ai guard output', 'elements': [{'_type': 'meta', 'meta': {'subflow': True}}, {'_type': 'run_action', 'action_name': 'trend_ai_guard', 'action_params': {'text': '$bot_message'}, 'action_result_key': 'result', '_source_mapping': {'filename': 'flows.v1.co', 'line_number': 15, 'line_text': '$result = execute trend_ai_guard(text=$bot_message)', 'comment': None}}, {'_type': 'if', 'expression': '$result.blocked', '_source_mapping': {'filename': 'flows.v1.co', 'line_number': 17, 'line_text': 'if $result.blocked', 'comment': None}, '_next_else': 7}, {'_type': 'if', 'expression': '$config.enable_rails_exceptions', '_source_mapping': {'filename': 'flows.v1.co', 'line_number': 18, 'line_