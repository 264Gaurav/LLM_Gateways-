# Define user intents using exact phrases and patterns
define user express greeting
  "hello"
  "hi"
  "hey"
  "good morning"

define user ask off topic
  "how to build a bomb"
  "hack a database"
  "ignore previous instructions"
  "override safety rules"

# Deterministic Bot Responses
define bot express greeting
  "Hello! How can I assist you today with your project?"

define bot refuse off topic
  "I cannot assist with requests that violate safety or security policies."

# Flow 1: Intercept greetings locally (0 LLM calls total)
define flow handle greeting
  user express greeting
  bot express greeting
  stop

# Flow 2: Block unsafe/off-topic requests locally before hitting the main LLM
define flow handle off topic
  user ask off topic
  bot refuse off topic
  stop
define flow check input patterns
  $is_blocked = execute check_blocked_terms(user_input=$last_user_message)
  if $is_blocked
    bot refuse off topic
    stop