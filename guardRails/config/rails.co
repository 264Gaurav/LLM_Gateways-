# ==============================================================================
# Colang 1.0 - Deterministic Input Guardrails (Zero LLM Intent Calls)
# ==============================================================================

# Deterministic Bot Response Templates
define bot express greeting
  "Hello! How can I assist you today with your project?"

define bot refuse off topic
  "I cannot assist with requests that violate safety or security policies."


# ------------------------------------------------------------------------------
# Input Rail 1: Intercept greetings & simple patterns via regex/exact match
# ------------------------------------------------------------------------------
define subflow handle greeting
  $is_greeting = execute check_greeting_terms(user_input=$last_user_message)
  if $is_greeting
    bot express greeting
    stop


# ------------------------------------------------------------------------------
# Input Rail 2: Block known malicious phrases & off-topic jailbreaks
# ------------------------------------------------------------------------------
define subflow check input patterns
  $is_blocked = execute check_blocked_terms(user_input=$last_user_message)
  if $is_blocked
    bot refuse off topic
    stop


# ------------------------------------------------------------------------------
# Input Rail 3: External Llama Guard Safety Action
# ------------------------------------------------------------------------------
define subflow check llama guard input
  $guard_result = execute check_llama_guard_input
  
  if not $guard_result.is_safe
    bot say "Request blocked due to safety policy violation. Hazard Type(s): {$guard_result.hazards}."
    stop