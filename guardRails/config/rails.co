# ==============================================================================
# Colang 1.0 - Deterministic Input Guardrails
# ==============================================================================

define bot express greeting
  "Hello! How can I assist you today with your project?"

define bot refuse off topic
  "I cannot assist with requests that violate safety or security policies."


# ------------------------------------------------------------------------------
# Input Rail 1: Intercept greetings
# ------------------------------------------------------------------------------
define subflow handle greeting
  $is_greeting = execute check_greeting_terms(user_input=$last_user_message)
  if $is_greeting
    bot express greeting
    stop


# ------------------------------------------------------------------------------
# Input Rail 2: Block known malicious phrases
# ------------------------------------------------------------------------------
define subflow check input patterns
  $is_blocked = execute check_blocked_terms(user_input=$last_user_message)
  if $is_blocked
    bot refuse off topic
    stop


# ------------------------------------------------------------------------------
# Input Rail 3: Detect and mask PII / secrets
# ------------------------------------------------------------------------------
define subflow check pii and mask
  $pii_result = execute check_pii_and_mask(user_input=$last_user_message)
  if not $pii_result.is_safe
    $msg = $pii_result.message
    bot say "$msg"
    stop
  
  # Export the masked string explicitly to the global context scope
  $masked_user_input = $pii_result.masked_input


# ------------------------------------------------------------------------------
# Input Rail 4: External Llama Guard Safety Action
# ------------------------------------------------------------------------------
define subflow check llama guard input
  # Pass the globally set $masked_user_input explicitly
  $guard_result = execute check_llama_guard_input(user_input=$masked_user_input)

  if not $guard_result.is_safe
    $hazards = $guard_result.hazards
    bot say "Request blocked due to safety policy violation. Hazard Type(s): $hazards."
    stop